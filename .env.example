# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Chain ---
# Base mainnet. The only chain OptionArena trades on.
CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org

# --- Signing (server-side only) ---
# Private key of a FRESH wallet created solely for this project.
# Never a personal wallet. Fund with the minimum needed for the demo.
# This key never reaches the browser. Leave empty to run in demo mode only.
PRIVATE_KEY=

# --- Agent ---
# The LLM that reads a plain-language view and returns a strategy.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Safety rails ---
# Hard ceiling on a single live trade, in whole USDC. Refuses above this.
MAX_TRADE_USDC=25

# --- Persistence (optional) ---
# Leave empty to use the local JSON store. Set to a Postgres URL to use Postgres.
DATABASE_URL=

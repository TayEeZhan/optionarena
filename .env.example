# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Chain ---
# Base mainnet. The only chain OptionArena trades on.
CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org

# --- Signing (server-side only) ---
# Private key of a FRESH wallet created solely for this project.
# Never a personal wallet. Fund with the minimum needed for the demo.
# This key never reaches the browser. Leave empty to run in demo mode only.
PRIVATE_KEY=

# --- Agent ---
# The LLM that reads a plain-language view and returns a strategy.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Safety rails ---
# Hard ceiling on a single live trade, in whole USDC. Refuses above this.
MAX_TRADE_USDC=25

# --- Sign-in ---
# Signs the session cookie. Any random string of 16+ characters; generate with
# `openssl rand -base64 32`. Without it, handle sign-in still works but Google
# is refused, because a verified account behind a forgeable cookie is worse
# than no account at all.
AUTH_SECRET=

# Google sign-in. Create a Web application OAuth client at
# console.cloud.google.com and register these exact redirect URIs:
#   http://localhost:5190/api/auth/google/callback
#   https://<your-deployment>/api/auth/google/callback
# Leave empty to hide the Google button; the handle path is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Persistence ---
# Leave empty to use the local JSON store, which is fine for local development.
# REQUIRED in production: a serverless filesystem is read-only and ephemeral, so
# without this the deployed feed and leaderboard silently lose every strategy.
# Free Postgres from neon.tech or supabase.com. Then: npm run db:push
DATABASE_URL=
